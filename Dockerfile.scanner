# Scanner agent image. Built separately from the web app so the two components
# can be hardened and granted capabilities independently. This image bundles
# nmap for active discovery and runs with the NET_RAW capability (added in
# compose for this service only) so it can send raw probes. The web app image
# never carries nmap or any network capability.
FROM golang:1.25-alpine AS build
# VERSION is stamped into the binary (main.version). Defaults to "dev"; the
# release workflow passes the git tag.
ARG VERSION=dev
WORKDIR /src
COPY go.mod ./
COPY go.sum* ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/scanner-agent ./cmd/scanner-agent

FROM alpine:3.20
RUN apk add --no-cache nmap nmap-scripts
WORKDIR /app
# Install on PATH so the bare name resolves for the Compose healthcheck
# (`scanner-agent --healthcheck`) and for interactive `docker exec`.
COPY --from=build /out/scanner-agent /usr/local/bin/scanner-agent
# Runs as root so nmap can use the raw sockets granted by NET_RAW. The container
# still drops every other capability (see compose), keeping the blast radius to
# this isolated discovery component.
EXPOSE 8443
ENTRYPOINT ["scanner-agent"]
