# Copy to .env and adjust. Docker Compose reads .env automatically.
# .env is gitignored, so values here survive `git pull`.

# --- Published-image deployment (compose.release.yaml) ---
# Exact stable image tag. Keep app and scanner on the same release.
LIGHTIPAM_VERSION=1.2.1

# Required by compose.release.yaml. Generate separate URL-safe values with
# `openssl rand -hex 32`; never commit the populated .env file.
POSTGRES_DB=lightipam
POSTGRES_USER=lightipam
POSTGRES_PASSWORD=
APP_SECRET=

# Optional dedicated base64-encoded 32-byte encryption key. When empty, the app
# derives it from APP_SECRET. Preserve whichever key is used with your backups.
APP_ENCRYPTION_KEY=

# Keep false only for loopback evaluation. Set true when TLS terminates at the
# reverse proxy in every deployment exposed beyond localhost.
COOKIE_SECURE=false

# Host port the web UI is published on. The container always listens on 8080
# internally; this only changes the host-side port. Set it when the default
# 8080 is already in use on the host.
APP_PORT=8080

# --- Optional scanner profile ---
# Uncomment the endpoint to auto-enroll the bundled scanner as pending.
# SCANNER_AGENT_ENDPOINT=https://scanner-agent:8443
# Replace the loopback-only default before enabling the scanner profile.
AGENT_ALLOWED_CIDRS=127.0.0.1/32
AGENT_ID=agent-local
AGENT_NAME=local-scanner-agent
AGENT_SCAN_PIN_MODE=auto
# Set only when using SNMP discovery. This credential stays on the agent.
AGENT_SNMP_COMMUNITY=not-configured

# --- Scanner macvlan overlay (deploy/compose.scanner-macvlan.yaml) ---
# Only needed when running the agent with macvlan for layer-2 MAC discovery of the
# subnet the agent is L2-connected to. Routed scans can still run through the default
# AGENT_SCAN_PIN_MODE=auto path, but nmap cannot collect MACs across an L3 boundary;
# use gateway SNMP/ARP-table or one scanner per VLAN when MAC discovery matters. See
# docs/SCANNER_AGENT.md "Choosing bridge vs macvlan" and ADR 0027.
# SCAN_LAN_PARENT must be a REAL interface on this host (`ip -br link`), or
# Docker rejects the network with "invalid subinterface vlan name".
SCAN_LAN_PARENT=eth0
SCAN_LAN_SUBNET=192.168.0.0/24
SCAN_LAN_GATEWAY=192.168.0.1
# A free address on SCAN_LAN_SUBNET, ideally outside the DHCP pool.
SCAN_LAN_AGENT_IP=192.168.0.250
